# ─── Database ─────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/sih26023?retryWrites=true&w=majority

# ─── Redis (optional — falls back to in-process if unavailable) ─────────────────
