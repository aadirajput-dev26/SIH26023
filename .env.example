# ─── JWT Authentication (change these secrets in production!) ─────────────────────
JWT_ACCESS_SECRET=geogyan-access-secret-change-in-prod
JWT_REFRESH_SECRET=geogyan-refresh-secret-change-in-prod

# ─── Email / SMTP ─────────────────────────────────────────────────────────────────
